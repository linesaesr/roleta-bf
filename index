<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <title>Roleta Black Friday</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <style>
    :root { color-scheme: light; }
    body{margin:0;background:#f8fafc}
    .ir-wrap{font:14px/1.5 system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial;
      color:#0f172a;background:#fff;border:1px solid #e5e7eb;border-radius:16px;
      box-shadow:0 6px 20px rgba(2,6,23,.06);padding:18px;max-width:720px;margin:24px auto;text-align:center}

    .ir-title{display:flex;gap:10px;align-items:center;justify-content:center;margin-bottom:10px}
    .ir-dot{width:12px;height:12px;border-radius:50%;
      background:linear-gradient(135deg,#22c55e,#3b82f6);box-shadow:0 0 0 1px #dbe3ef}
    .ir-title h2{margin:0;font-size:22px;font-weight:800;color:#111827}
    .ir-title h3{margin:2px 0 0;font-size:16px;font-weight:600;color:#374151}

    /* Ponteiro para baixo, dentro da roda */
    .ir-pointer{
      width:0;height:0;
      border-left:12px solid transparent;border-right:12px solid transparent;border-top:20px solid #ef4444;
      margin:0 auto;position:relative;bottom:-10px;z-index:10
    }

    .ir-wheel{--size:300px;width:var(--size);height:var(--size);border-radius:50%;
      border:10px solid #eef2f7;margin:10px auto;position:relative;overflow:hidden;
      box-shadow:inset 0 0 0 1px #e2e8f0;transform:rotate(0deg);background:#fff}
    .ir-center{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
      font-weight:800;color:#334155}

    .ir-labels{position:absolute;inset:0;pointer-events:none;z-index:2}
    .ir-label{position:absolute;left:50%;top:50%;transform-origin:50% 50%;
      text-align:center;font-weight:800;color:#334155;font-size:14px;line-height:1.2}
    .ir-label span{display:inline-block;background:rgba(255,255,255,.9);padding:2px 6px;border-radius:8px;
      box-shadow:0 0 0 1px #e2e8f0;white-space:nowrap}

    .ir-actions{display:flex;gap:10px;justify-content:center;margin-top:12px;flex-wrap:wrap}
    .ir-btn{appearance:none;border:0;border-radius:10px;padding:12px 16px;font-weight:800;cursor:pointer}
    .ir-btn.primary{background:#3b82f6;color:#fff}
    .ir-btn.ghost{background:#f1f5f9}

    .ir-res{margin-top:14px}
    .ir-picked{display:inline-block;background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;
      padding:8px 10px;font-weight:700;margin-bottom:8px}
    .ir-cta{display:inline-block;margin-top:6px;background:#0ea5e9;color:#fff;border-radius:10px;
      padding:10px 14px;font-weight:800;text-decoration:none}

    /* Pulse animation */
    @keyframes pulse{0%{transform:scale(1)}50%{transform:scale(1.08)}100%{transform:scale(1)}}
    .pulsing{animation:pulse 1.2s infinite;will-change:transform;transform:translateZ(0)}
    @media (prefers-reduced-motion: reduce){.pulsing{animation:none}}

    /* Compacto para mobile */
    @media (max-width: 480px){
      .ir-title h2{font-size:20px}
      .ir-title h3{font-size:14px}
      .ir-wheel{--size:220px;border-width:8px}
      .ir-label{font-size:12px}
      .ir-btn{flex:1}
      .ir-pointer{border-top-width:16px;bottom:-8px}
    }
  </style>
</head>
<body>
  <section id="intent-roulette" class="ir-wrap" aria-label="Roleta de intenções">
    <div class="ir-title">
      <i class="ir-dot" aria-hidden="true"></i>
      <div>
        <h2>Roleta Black Friday</h2>
        <h3>Gire e destrave ofertas incríveis!</h3>
      </div>
    </div>

    <!-- Ponteiro (apontando para baixo, dentro da roda) -->
    <div class="ir-pointer" aria-hidden="true"></div>

    <!-- Roleta -->
    <div class="ir-wheel" id="ir-wheel" aria-live="polite">
      <div class="ir-labels" id="ir-labels"></div>
      <div class="ir-center">Gire</div>
    </div>

    <!-- Ações -->
    <div class="ir-actions">
      <button class="ir-btn primary" id="ir-spin">Girar roleta</button>
      <button class="ir-btn ghost" id="ir-reset">Tentar novamente</button>
    </div>

    <!-- Resultado -->
    <div class="ir-res" id="ir-res" hidden>
      <div class="ir-picked">
        <strong>Você caiu em:</strong> <span id="ir-intent">—</span>
      </div>
      <a class="ir-cta" id="ir-link" href="#" rel="nofollow">Ver recomendações →</a>
      <div class="ir-foot" style="color:#64748b;font-size:12px;margin-top:6px">
        *Você será direcionado(a) ao nosso recomendador.
      </div>
    </div>
  </section>

  <script>
    (function(){
      // Itens e URLs (ajuste para suas páginas)
      const TARGETS = [
        { label:'Smartwatch',  url:'/rec-produtos-smartwatch/' },
        { label:'Headphone',   url:'/rec-produtos-headphone/' },
        { label:'Smartphone',  url:'/rec-produtos-smartphone/' },
        { label:'Cadeira Gamer', url:'/rec-produtos-cadeira-gamer/' }
      ];
      const colors = ['#fecaca','#fde68a','#bbf7d0','#bfdbfe','#ddd6fe','#fbcfe8','#a7f3d0','#fef08a'];

      const wheel   = document.getElementById('ir-wheel');
      const labels  = document.getElementById('ir-labels');
      const spinBtn = document.getElementById('ir-spin');
      const resetBtn= document.getElementById('ir-reset');
      const resBox  = document.getElementById('ir-res');
      const picked  = document.getElementById('ir-intent');
      const link    = document.getElementById('ir-link');

      // Começa com pulso no botão de girar
      spinBtn.classList.add('pulsing');

      function paint(){
        const n = TARGETS.length, step = 360/n;
        // fundo em fatias
        const parts=[];
        for(let i=0;i<n;i++){ parts.push(`${colors[i%colors.length]} ${i*step}deg ${(i+1)*step}deg`); }
        wheel.style.background = `conic-gradient(${parts.join(',')})`;

        // labels
        labels.innerHTML='';
        const radius = (wheel.clientWidth/2) - 28; // folga da borda
        for(let i=0;i<n;i++){
          const mid = i*step + step/2;
          const el = document.createElement('div');
          el.className = 'ir-label';
          el.style.transform = `translate(-50%,-50%) rotate(${mid}deg) translate(0,-${radius}px) rotate(${-mid}deg)`;
          el.innerHTML = `<span>${TARGETS[i].label}</span>`;
          labels.appendChild(el);
        }
      }
      paint();
      window.addEventListener('resize', paint); // recalcula em resize

      let spinning=false;
      function spin(){
        if(spinning) return;
        spinning=true;

        const n = TARGETS.length, step = 360/n;
        const idx = Math.floor(Math.random()*n);
        const mid = idx*step + step/2;

        const target = 5*360 + (360 - mid); // parar com a fatia escolhida no ponteiro (topo)

        // alterna pulsos
        spinBtn.classList.remove('pulsing');
        link.classList.remove('pulsing');

        wheel.style.transition = 'transform 2.3s cubic-bezier(.2,.7,.1,1)';
        wheel.style.transform  = `rotate(${target}deg)`;

        setTimeout(()=>{
          spinning=false;
          picked.textContent = TARGETS[idx].label;
          link.href = TARGETS[idx].url;
          resBox.hidden = false;
          // pulso no CTA
          link.classList.add('pulsing');
        }, 2400);
      }

      function reset(){
        wheel.style.transition = 'none';
        wheel.style.transform  = 'rotate(0deg)';
        resBox.hidden = true;
        // volta pulso para o botão de girar
        spinBtn.classList.add('pulsing');
        link.classList.remove('pulsing');
      }

      spinBtn.addEventListener('click', spin);
      resetBtn.addEventListener('click', reset);
    })();
  </script>
</body>
</html>
